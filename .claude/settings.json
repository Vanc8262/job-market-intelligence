{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m ruff:*)",
      "Bash(.venv/Scripts/python.exe -m mypy:*)",
      "Bash(.venv/Scripts/python.exe scripts/verify_project.py:*)",
      "Bash(.venv/Scripts/python.exe scripts/compare_applications.py:*)",
      "Bash(.venv/Scripts/python.exe scripts/manage_resumes.py list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
