# Optional local overrides. Copy to .env; never commit .env.
# Every value below is optional and overrides config/settings.yaml.

# JMIP_ENVIRONMENT=development
# JMIP_LOGGING_LEVEL=INFO
# JMIP_STORAGE_DEFAULT=json
# JMIP_SCRAPING_MAX_RETRIES=5
# JMIP_SCRAPING_CHECKPOINT_INTERVAL=100

# Folder holding Bronze/Silver/Gold/checkpoints, e.g. a clone of the private data repo.
# JMIP_PIPELINE_DATA_DIR=../jmip-data
